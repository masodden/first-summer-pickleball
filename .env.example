# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Обязательное ---

# Домен приложения без https:// — например pickleball.example.com
APP_DOMAIN=pickleball.example.com

# Пароль базы. Придумайте длинный случайный, например: openssl rand -hex 24
POSTGRES_PASSWORD=

# Секрет для подписи токенов сессии: openssl rand -hex 32
JWT_SECRET=

# Код, которым администраторы клуба (PZQZKM и P5ML0M) подтверждают себя
# при первом входе. Придумайте свой и никому не показывайте.
BOOTSTRAP_ADMIN_CODE=

# --- Telegram ---

# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — нужно для ссылок-приглашений
TELEGRAM_BOT_USERNAME=
# Секрет вебхука: openssl rand -hex 16
# Если оставить пустым, бот будет работать опросом (годится для локальной разработки).
TELEGRAM_WEBHOOK_SECRET=

# --- Необязательное ---

POSTGRES_USER=fsp
POSTGRES_DB=fsp
LOG_LEVEL=info

# Локальная разработка без Docker:
# DATABASE_URL=postgres://fsp:fsp@localhost:5432/fsp
# ALLOW_DEV_LOGIN=true
# PUBLIC_WEB_URL=http://localhost:4200
