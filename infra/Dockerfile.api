# syntax=docker/dockerfile:1

FROM node:24-alpine AS build
RUN corepack enable
WORKDIR /app
# Без TTY pnpm не решается сам пересобрать node_modules и падает — CI=true снимает вопрос.
ENV CI=true

# Сначала только манифесты: слой с зависимостями переиспользуется между сборками.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/engine/package.json packages/engine/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter "@fsp/api..."

COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm --filter @fsp/shared build \
  && pnpm --filter @fsp/engine build \
  && pnpm --filter @fsp/api build

# Выкидываем инструменты сборки: в образ попадут только рантайм-зависимости.
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --filter "@fsp/api..."

FROM node:24-alpine AS runtime
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "apps/api/dist/server.js"]
