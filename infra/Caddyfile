# Caddy сам получает и продлевает сертификат Let's Encrypt для APP_DOMAIN.
# Если домена нет, поставьте APP_DOMAIN=:80 — тогда сайт откроется по IP без HTTPS,
# но Telegram Mini App требует HTTPS, поэтому для бота домен обязателен.

{$APP_DOMAIN} {
	encode zstd gzip

	# API и WebSocket живут на том же домене: это избавляет от настройки CORS
	# и от отдельного поддомена.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle /ws {
		reverse_proxy api:3000
	}

	# Иначе SPA try_files отдаст index.html как /robots.txt — Lighthouse
	# разбирает HTML как директивы (~20 ошибок). respond, а не file_server:
	# не зависит от того, попал ли файл в /srv.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=300"
		respond "User-agent: *\nAllow: /\nDisallow: /api/\nDisallow: /ws\n" 200
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Хэшированные файлы сборки можно кэшировать надолго.
		# Angular ставит смешанный регистр и иногда дефис: chunk-BE5K2gws.js, chunk-DxvF7-ch.js.
		@immutable path_regexp \-[A-Za-z0-9_-]+\.(js|css|woff2)$
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Mini App открывается как `/`, не как `/index.html`. Telegram WebView
		# агрессивно кэширует документ — без no-store Play из бота отдаёт старый бандл.
		@spaDocument {
			path /
			path *.html
		}
		header @spaDocument Cache-Control "no-cache, no-store, must-revalidate"
		header @spaDocument Pragma "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
